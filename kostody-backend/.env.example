# --- Server ---
PORT=5000

# --- Database (PostgreSQL) ---
# Connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/kostody

# --- Auth ---
# Secret used to sign and verify JWTs. Use a long, random value.
# The server refuses to start if this is missing.
JWT_SECRET=replace-with-a-long-random-secret

# --- Cloudinary (job photo uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
